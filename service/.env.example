# memory-pool service environment: copy to .env and fill in
BIND=127.0.0.1
PORT=3102

# Basic auth for the web UI (/ui and /api/*). Leave empty to disable the UI.
UI_USER=admin
UI_PASSWORD=change-me

# Qdrant: the same instance your SillyTavern st-qdrant-memory extension uses,
# if you want to share its collections (reach it over a private network).
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Embeddings: must produce the same vectors as whatever built the collection
# (for st-qdrant-memory, the same model and dimensions).
# Providers: openai | openrouter | custom (set EMBEDDINGS_URL) | stub (tests only)
EMBEDDINGS_PROVIDER=openrouter
EMBEDDINGS_API_KEY=
#EMBEDDINGS_URL=
